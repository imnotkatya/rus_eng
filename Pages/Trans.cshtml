@page
@model DictionaryWebApp.Pages.TransModel
@using DictionaryWebApp.Models
@{
    ViewData["Title"] = "Перевод";
}

<h1>🔤 Перевод слова</h1>

<form method="post" class="translate-form">

    <div class="mode-switch">
        <span class="mode-title">Режим работы:</span>
        <label>
            <input type="radio" name="Mode" value="EngToRus" checked="@(Model.Mode == TranslationMode.EngToRus)" />
            Англо-русский (@Model.Directions[0].WordsCount сл.)
        </label>
        <label>
            <input type="radio" name="Mode" value="RusToEng" checked="@(Model.Mode == TranslationMode.RusToEng)" />
            Русско-английский (@Model.Directions[1].WordsCount сл.)
        </label>
    </div>

    <div class="input-row">
        <input type="text" id="Word" name="Word" value="@Model.Word" maxlength="50"
               placeholder="Введите слово, например book или дом" autocomplete="off" autofocus />
        <button type="submit">Перевести</button>
    </div>

</form>

@if (Model.ErrorMessage != null)
{
    <div class="result error">⚠️ @Model.ErrorMessage</div>
}

@if (Model.Translations != null)
{
    if (Model.Translations.Count > 0)
    {
        <div class="result success">
            <strong>@Model.Word</strong> — переводов: @Model.Translations.Count
            <div class="syno-translations mt-2">
                @foreach (string t in Model.Translations)
                {
                    <span class="syno-tag">@t</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="result error">⚠️ Слово «@Model.Word» не найдено в словаре.</div>
    }
}
