@page
@model DictionaryWebApp.Pages.TransModel
@using DictionaryWebApp.Models
@{
    ViewData["Title"] = "Перевод";
}

<h1>🔤 Перевод слова</h1>

<form method="post" class="translate-form">

    <div class="mode-switch">
        <span class="mode-title">Режим работы:</span>
        @foreach (var dir in Model.Directions)
        {
            <label>
                <input type="radio" asp-for="Mode" value="@dir.Mode.ToString()" />
                @dir.Title (@dir.WordsCount сл.)
            </label>
        }
    </div>

    <div class="input-row">
        <input type="text"
               asp-for="Word"
               maxlength="50"
               placeholder="@(Model.Mode == TranslationMode.EngToRus ? "Введите английское слово, например book" : "Введите русское слово, например дом")"
               autocomplete="off"
               autofocus />
        <button type="submit">Перевести</button>
    </div>

</form>

@if (Model.ErrorMessage != null)
{
    <div class="result error">
        ⚠️ @Model.ErrorMessage
    </div>
}

@if (Model.Searched && Model.ErrorMessage == null && Model.Translations != null)
{
    @if (Model.Translations.Count > 0)
    {
        <div class="result success">
            <strong>@Model.Word</strong> —
            @(Model.Translations.Count == 1 ? "перевод:" : $"переводов: {Model.Translations.Count}")
            <div class="syno-translations mt-2">
                @foreach (var t in Model.Translations)
                {
                    <span class="syno-tag">@t</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="result error">
            ⚠️ Слово «@Model.Word» не найдено в словаре.
        </div>
    }
}
