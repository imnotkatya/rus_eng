@page
@model DictionaryWebApp.Pages.SynoModel
@using DictionaryWebApp.Models
@{
    ViewData["Title"] = "Синонимы";
}

<h1>🔁 Слова с несколькими переводами</h1>

<form method="get" class="dict-controls">
    <div class="control-group">
        <label for="Mode">Направление:</label>
        <select name="Mode" id="Mode" onchange="this.form.submit()">
            @if (Model.Mode == null)
            {
                <option value="" selected>Оба направления</option>
            }
            else
            {
                <option value="">Оба направления</option>
            }

            @if (Model.Mode == TranslationMode.EngToRus)
            {
                <option value="EngToRus" selected>Англо → Русский</option>
            }
            else
            {
                <option value="EngToRus">Англо → Русский</option>
            }

            @if (Model.Mode == TranslationMode.RusToEng)
            {
                <option value="RusToEng" selected>Русский → Английский</option>
            }
            else
            {
                <option value="RusToEng">Русский → Английский</option>
            }
        </select>
    </div>

    <div class="total-count">
        Найдено слов: <strong>@Model.Words.Count</strong>
    </div>
</form>

@if (Model.Words.Count == 0)
{
    <div class="result error">⚠️ В словаре нет слов с несколькими переводами.</div>
}

<div class="syno-list">
    @foreach (SynonymInfo item in Model.Words)
    {
        <div class="syno-card">
            <div class="syno-word">
                @item.Word
                @if (item.Direction == TranslationMode.EngToRus)
                {
                    <div class="syno-dir">англ. → рус.</div>
                }
                else
                {
                    <div class="syno-dir">рус. → англ.</div>
                }
            </div>
            <div class="syno-translations">
                @foreach (string t in item.Synonyms)
                {
                    <span class="syno-tag">@t</span>
                }
            </div>
        </div>
    }
</div>
