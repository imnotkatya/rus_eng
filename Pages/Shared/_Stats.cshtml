@model DictionaryWebApp.Models.DictionaryStats

<div class="stats">
    <div class="stat"><span>Записей в словаре</span><strong>@Model.RecordsCount</strong></div>
    <div class="stat"><span>Английских слов</span><strong>@Model.EngWordsCount</strong></div>
    <div class="stat"><span>Русских слов</span><strong>@Model.RusWordsCount</strong></div>
    <div class="stat"><span>Слов с синонимами</span><strong>@(Model.EngWordsWithSynonymsCount +
                            Model.RusWordsWithSynonymsCount)</strong></div>
    </div>
